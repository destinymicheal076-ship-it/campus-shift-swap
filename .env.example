# Copy to .env.local and fill in from Supabase: Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "anon" (or "publishable") key. Safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "service_role" (or "secret") key. Server-only: used by npm run seed. Never commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Time zone shifts are shown in (campus time), e.g. Africa/Lagos.
APP_TIME_ZONE=Africa/Lagos
